{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Producto",
    "type": "object",
    "properties": {
        "foto": {
            "type": "string"
        },
        "nombre": {
            "type": "string"
        },
        "descripcion": {
            "type": "string"
        },
        "categoria": {
            "type": "string"
        },
        "precio": {
            "type": "number"
        }
    },
    "required": ["foto", "nombre", "descripcion", "categoria"]
}
